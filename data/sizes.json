{
  "$schema": "./schema.json",
  "meta": {
    "title": "Social Media Image Sizes Reference Guide",
    "repository": "https://github.com/chuckreynolds/social-profile-image-sizes",
    "license": "MIT",
    "last_verified": "2026-07-24",
    "units": "pixels",
    "about_published_flag": "published:false means the platform states no such size in any first-party documentation. The value is an observed convention that generally renders well, but it cannot be cited and may drift."
  },
  "platforms": [
    {
      "id": "x",
      "name": "X (formerly Twitter)",
      "aka": [
        "Twitter"
      ],
      "note": "X retired its Cards documentation when developer.x.com moved to docs.x.com — the old deep links now redirect to a generic overview and no replacement spec page exists. The card values below are the last officially published figures and can no longer be confirmed first-party.",
      "sources": [
        {
          "title": "help.x.com — uploading profile photos and headers and best sizes",
          "url": "https://help.x.com/en/managing-your-account/common-issues-when-uploading-profile-photo"
