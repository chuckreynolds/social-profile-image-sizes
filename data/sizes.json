      ],
      "assets": [
        {
          "id": "profile-photo",
          "label": "Profile Photo",
          "render": "400 x 400",
          "width": 400,
          "height": 400,
          "aspect": "1:1",
          "max_bytes": 2097152,
          "formats": [
            "jpeg",
            "gif",
            "png"
          ],
          "qualifier": "max 2MB; JPEG / GIF / PNG, no animated GIFs",
          "published": true,
          "source_url": "https://help.x.com/en/managing-your-account/common-issues-when-uploading-profile-photo",
          "verified": "2026-07-24"
        },
        {
          "id": "header",
          "label": "Header Image",
          "render": "1500 x 500",
          "width": 1500,
          "height": 500,
          "aspect": "3:1",
          "qualifier": "~60 px top and bottom can crop depending on monitor/browser",
          "published": true,
          "source_url": "https://help.x.com/en/managing-your-account/common-issues-when-uploading-profile-photo",
          "verified": "2026-07-24"
        },
        {
          "id": "post-image",
          "label": "Post Image",
          "render": "1024 x 512",
          "width": 1024,
          "height": 512,
          "aspect": "2:1",
          "qualifier": "displays inline as 506 x 253; 1200 x 675 also common for landscape",
          "published": false,
          "verified": "2026-07-24",
          "also": [
            {
              "label": "display",
              "width": 506,
              "height": 253,
              "description": "inline render in the timeline"
