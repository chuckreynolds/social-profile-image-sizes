{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/chuckreynolds/social-profile-image-sizes/master/data/schema.json",
  "title": "Social Media Image Sizes",
  "description": "Sourced image and video dimensions for social platforms. Values with published:false are observed conventions, not documented specs.",
  "type": "object",
  "required": ["meta", "platforms"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "meta": {
      "type": "object",
      "required": ["last_verified", "units"],
      "properties": {
        "title": { "type": "string" },
        "repository": { "type": "string", "format": "uri" },
        "license": { "type": "string" },
        "last_verified": { "$ref": "#/$defs/date" },
        "units": { "const": "pixels" },
        "about_published_flag": { "type": "string" }
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/platform" }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO 8601 date, YYYY-MM-DD"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "source": {
      "type": "object",
      "required": ["title", "url"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "platform": {
      "type": "object",
      "required": ["id", "name", "sources", "assets"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "name": { "type": "string" },
        "aka": { "type": "array", "items": { "type": "string" } },
        "subtitle": { "type": "string" },
        "note": {
          "type": "string",
          "description": "Caveat rendered under the platform's asset list."
        },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "assets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/asset" }
        }
      }
    },
    "asset": {
      "type": "object",
      "required": ["id", "label", "render", "published", "verified"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "label": {
          "type": "string",
          "description": "Human-readable asset name, e.g. 'Profile Photo'."
        },
        "group": {
          "type": "string",
          "description": "Optional sub-heading grouping assets within a platform."
        },
        "render": {
          "type": "string",
          "description": "The dimension phrase as it appears in the README. Cross-checked against width/height/min/max by scripts/validate.js."
        },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "aspect": {
          "type": "string",
          "pattern": "^[0-9.]+:[0-9.]+$",
          "description": "Aspect ratio as W:H, e.g. '16:9' or '1.91:1'."
        },
        "min": { "$ref": "#/$defs/dimensions" },
        "max": { "$ref": "#/$defs/dimensions" },
        "sizes": {
          "type": "array",
          "items": { "$ref": "#/$defs/dimensions" },
          "description": "For assets that are a set of required sizes rather than one, e.g. Twitch emotes."
        },
        "also": {
          "type": "array",
          "description": "Secondary dimensions worth knowing: rendered display size, safe area, accepted alternates.",
          "items": {
            "type": "object",
            "required": ["label", "width", "height"],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "enum": ["display", "safe-area", "alternate", "minimum-for-feature"]
              },
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 },
              "description": { "type": "string" }
            }
          }
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum file size in bytes."
        },
        "formats": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9]+$" }
        },
        "qualifier": {
          "type": "string",
          "description": "Parenthetical detail rendered inline after the dimension."
        },
        "detail": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Sub-bullets rendered beneath the asset line."
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Machine-facing context. Not rendered into the README."
        },
        "published": {
          "type": "boolean",
          "description": "true = stated in first-party documentation at source_url. false = observed convention with no citable source."
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "description": "Required when published is true."
        },
        "verified": { "$ref": "#/$defs/date" }
      },
      "allOf": [
        {
          "if": { "properties": { "published": { "const": true } }, "required": ["published"] },
          "then": { "required": ["source_url"] }
        }
      ]
    }
  }
}
